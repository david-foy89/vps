# Public site URL used for canonical links, Open Graph, sitemap, and JSON-LD.
# Set this to the production domain before launch. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (example: G-XXXXXXXX). Leave unset to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID. Leave unset to disable.
NEXT_PUBLIC_META_PIXEL_ID=

CONTACT_TO_EMAIL=mickey-vps@outlook.com

# Verified sender. For Outlook SMTP this is the same mailbox.
CONTACT_FROM_EMAIL=mickey-vps@outlook.com

# Preferred mailer. If RESEND_API_KEY is set, Resend is used.
RESEND_API_KEY=

# Nodemailer fallback. Used only when RESEND_API_KEY is empty and SMTP_HOST is set.
# Outlook: SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587, SMTP_USER=mickey-vps@outlook.com
# SMTP_PASS must be an app password. Until that is set, quote forms open a mailto to the inbox above.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
